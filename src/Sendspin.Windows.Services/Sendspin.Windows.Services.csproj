<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <!-- Overrides the System.Drawing.Common 4.7.0 that Microsoft.Toolkit.Uwp.Notifications 7.1.3 depends
         on: CVE-2021-24112 (GHSA-rxg9-xrhp-64gj, NU1904) affects everything below 4.7.2. No build ships
         4.7.0, because the WindowsDesktop shared framework's copy wins in framework-dependent and
         self-contained alike; this takes it out of the dependency graph. 7.1.3 is the toolkit's newest
         release, and CommunityToolkit.WinUI.Notifications is older and has the same dependency, so
         switching packages would not help. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.13" />
    <!-- Before upgrading NAudio: WasapiAudioPlayer reads WasapiOut's private "audioClient" field by
         reflection (TryGetAudioClient, GetAudioClockClient). If a new version renames it, output latency
         falls back to an estimate with only a log warning, costing multi-room sync, and the opt-in
         device clock becomes unavailable without any message. Check the field still exists. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="DiscordRichPresence" Version="1.3.0.28" />
  </ItemGroup>

  <!--
    SDK reference: the published NuGet package by default. When built with
    -p:UseSdkSource=true -p:SdkSourcePath=<path>, reference the checked-out SDK
    source instead (used by .github/workflows/ci-sdk-dev.yml to test against the
    SDK's dev branch). Unset property => NuGet path, so normal builds are unaffected.
  -->
  <ItemGroup Condition="'$(UseSdkSource)' != 'true'">
    <PackageReference Include="Sendspin.SDK" Version="10.1.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseSdkSource)' == 'true'">
    <ProjectReference Include="$(SdkSourcePath)\src\Sendspin.SDK\Sendspin.SDK.csproj" />
  </ItemGroup>

</Project>
